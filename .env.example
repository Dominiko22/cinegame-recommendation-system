DJANGO_SECRET_KEY="change-this-secret-key"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# Default development database.
DB_ENGINE=sqlite

# Optional MySQL configuration. Set DB_ENGINE=mysql to use it.
# DB_ENGINE=mysql
# DB_NAME="recommender_db"
# DB_USER="root"
# DB_PASSWORD="your-database-password"
# DB_HOST="127.0.0.1"
# DB_PORT="3307"

TMDB_ACCESS_TOKEN="your-tmdb-read-access-token"
TMDB_API_BASE_URL="https://api.themoviedb.org/3"
TMDB_LANGUAGE="pl-PL"
